# Ключ создаётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Разработка и обычная игра: дёшево, быстро, поддерживает строгий JSON.
OPENROUTER_MODEL=google/gemini-3.8-flash-20260902
# Демо и защита: заметно живее в роли, полный прогон стоит меньше доллара.
# OPENROUTER_MODEL=anthropic/claude-opus-5-20260723

# true — оппонент играется детерминированным движком, обращений к сети нет вообще.
DEMO_MODE=false

# Генерация кейсов в /admin. Если не задана, берётся OPENROUTER_MODEL.
# OPENROUTER_GEN_MODEL=

# Распознавание голоса тем же ключом. Если модель недоступна, сервер пробует openai/whisper-1.
# OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe
